# Paper-mode worker. Never put a TON private key here. This build cannot sign.
TON_GRAM_NETWORK=mainnet
TON_GRAM_DATA_DIR=/data
TON_GRAM_HOST=0.0.0.0
TON_GRAM_PORT=43177
TON_GRAM_SNAPSHOT_BEARER_TOKEN=replace-with-a-long-random-token

# Poller
TON_GRAM_POLL_INTERVAL_S=15
TON_GRAM_MAX_QUOTE_AGE_MS=15000
TON_GRAM_ENABLE_TONCENTER=true

# Limits (2% position cap is 200 bps of funding cap)
TON_GRAM_FUNDING_CAP_USDT_MICRO=10000000000
TON_GRAM_POSITION_CAP_BPS=200
TON_GRAM_DAILY_LOSS_BPS=100
TON_GRAM_DRAWDOWN_BPS=300
TON_GRAM_MAX_TRADE_USDT_MICRO=50000000
TON_GRAM_GRAM_GAS_RESERVE_NANO=250000000
TON_GRAM_MIN_LIQUIDITY_USD_MICRO=500000000000

# Baseline strategy
TON_GRAM_STRATEGY_LOOKBACK=8
TON_GRAM_STRATEGY_ENTRY_DEVIATION_BPS=25
TON_GRAM_STRATEGY_TRADE_USDT_MICRO=50000000

# Telegram outbound alerts (off unless both set and enabled)
TON_GRAM_TELEGRAM_ENABLED=false
TON_GRAM_TELEGRAM_BOT_TOKEN=
TON_GRAM_TELEGRAM_CHAT_ID=
